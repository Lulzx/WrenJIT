+      {
+        // 1. Check for existing compiled trace.
+        JitTrace* jitTrace = wrenJitLookup(vm->jit, ip);
+        if (jitTrace != NULL)
+        {
+          STORE_FRAME();
+          wrenJitExecute(vm, jitTrace);
+          // wrenJitExecute restores side-exit metadata after the generated
+          // stub materializes live values.
+          LOAD_FRAME();
+          DISPATCH();
+        }
+
+        // 2. If recording, the dispatch hook (JIT_TRACE_INSTRUCTION) handles
+        // loop-back detection and compilation. Nothing to do here.
+        if (wrenJitIsRecording(vm->jit))
+        {
+          DISPATCH();
+        }
+
+        // 3. Not recording and no trace: increment this function's counter.
+        // Allocate lazily so functions which never loop pay no storage cost.
+        {
+          int pcOffset = (int)(ip - fn->code.data);
+          if (fn->jitHotCounts == NULL)
+          {
+            STORE_FRAME();
+            fn->jitHotCounts = ALLOCATE_ARRAY(vm, uint16_t, fn->code.count);
+            memset(fn->jitHotCounts, 0,
+                   sizeof(uint16_t) * (size_t)fn->code.count);
+            LOAD_FRAME();
+          }
+
+          uint16_t* hotCount = &fn->jitHotCounts[pcOffset];
+          if (*hotCount != JIT_HOT_BLACKLISTED &&
+              wrenJitIncrementHot(vm->jit, hotCount))
+          {
+            // Loop just became hot - start recording. The recorder retains the
+            // counter pointer so an unsupported/failed trace can blacklist it.
+            STORE_FRAME();
+            jitRecorderStart(vm->jit, ip,
+                              (int)(fiber->stackTop - stackStart), hotCount);
+            LOAD_FRAME();
+          }
+        }
+      }
+#endif /* WREN_JIT */
+
       DISPATCH();
     }
 
